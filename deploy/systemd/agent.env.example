# Install as /etc/qcontrolhub/agent.env with owner root:root and mode 0600.
# EnvironmentFile syntax is KEY=VALUE; do not add `export`.

QCH_SERVER_URL=wss://qcontrolhub.example.com

# Only for a private/self-signed control-plane CA. Install the PEM file as a
# root-owned, non-symlink file first; public Web PKI certificates need no override.
# QCH_TLS_CA_FILE=/etc/qcontrolhub/control-plane-ca.pem

# Required while adding or reinstalling this node. Paste its node-bound
# credential, then remove this line after the state file exists.
QCH_ENROLLMENT_TOKEN=PASTE_THE_ADD_NODE_CREDENTIAL_HERE

QCH_AGENT_STATE=/var/lib/qcontrolhub/agent-state.json
QCH_AGENT_NAME=edge-01
QCH_AGENT_LABELS=region=cn-east,role=edge
QCH_AGENT_ENGINES=mihomo,xray,sing-box,ss-rust
# Existing services discovered by the one-click installer remain read-only
# until an administrator confirms migration from the manual configuration page.
# QCH_EXISTING_XRAY_BINARY=/usr/bin/xray
# QCH_EXISTING_XRAY_CONFIG=/etc/xray/config.json
# QCH_EXISTING_XRAY_SERVICE=xray.service
# A discovered sing-box `run -c FILE -C DIR` mapping also records the exact
# protected directory and the systemd executable token. Do not set these by
# hand unless the service argv and fixed binary/forwarder mapping were checked.
# QCH_EXISTING_SING_BOX_BINARY=/usr/lib/sing-box/sing-box
# QCH_EXISTING_SING_BOX_CONFIG=/etc/sing-box/config.json
# QCH_EXISTING_SING_BOX_CONFIG_DIRECTORY=/etc/sing-box/conf.d
# QCH_EXISTING_SING_BOX_SERVICE_BINARY=/usr/local/bin/sing-box
# QCH_EXISTING_SING_BOX_SERVICE=sing-box.service
QCH_HEARTBEAT_INTERVAL=15s
QCH_METRICS_INTERVAL=1s

# Safe default: validation is structural only and no file/service changes occur.
# Change to false only after checking every binary, path and service mapping below.
QCH_ALLOW_HTTP=false

QCH_MIHOMO_BINARY=/usr/local/lib/qagent/cores/mihomo
QCH_MIHOMO_CONFIG=/etc/qagent/mihomo/config.yaml
QCH_MIHOMO_SERVICE=qagent-mihomo.service

QCH_XRAY_BINARY=/usr/local/lib/qagent/cores/xray
QCH_XRAY_CONFIG=/etc/qagent/xray/config.json
QCH_XRAY_SERVICE=qagent-xray.service

QCH_SING_BOX_BINARY=/usr/local/lib/qagent/cores/sing-box
QCH_SING_BOX_CONFIG=/etc/qagent/sing-box/config.json
QCH_SING_BOX_SERVICE=qagent-sing-box.service

QCH_SS_RUST_BINARY=/usr/local/lib/qagent/cores/ssserver
QCH_SS_RUST_CONFIG=/etc/qagent/shadowsocks-rust/config.json
QCH_SS_RUST_SERVICE=qagent-shadowsocks-rust.service
